{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "fernandodias/discogs-php",
  "type": "library",
  "description": "A modern, framework-agnostic and type-safe PHP client for the Discogs API.",
  "keywords": [
    "discogs",
    "api",
    "client",
    "music",
    "vinyl"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Fernando Dias"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.10",
    "laravel/pint": "^1.27",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "guzzlehttp/guzzle": "Provides a PSR-18 HTTP client and PSR-17 HTTP factories."
  },
  "autoload": {
    "psr-4": {
      "FernandoDias\\Discogs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FernandoDias\\Discogs\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": [
      "@php vendor/bin/pint"
    ],
    "lint": [
      "@php vendor/bin/pint --test"
    ],
    "analyse": [
      "@php vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "test": [
      "@php vendor/bin/phpunit"
    ],
    "security:check": [
      "@composer audit --locked"
    ],
    "check": [
      "@composer validate --strict @no_additional_args",
      "@composer check-platform-reqs @no_additional_args",
      "@lint @no_additional_args",
      "@analyse @no_additional_args",
      "@test @no_additional_args"
    ],
    "check:all": [
      "@check @no_additional_args",
      "@security:check @no_additional_args"
    ]
  },
  "scripts-descriptions": {
    "format": "Format the source code with Laravel Pint.",
    "lint": "Check code style without changing files.",
    "analyse": "Run PHPStan static analysis.",
    "test": "Run the PHPUnit test suite.",
    "security:check": "Check dependencies for known security advisories.",
    "check": "Run the local quality gate.",
    "check:all": "Run the complete quality and security gate."
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
